/*
 * Source: dctxmei/rofi-themes (1080p/launchers/misc/blurry.rasi)
 *
 * Made nearly opaque: there is no blur (compton), so with a see-through
 * background the windows behind made the app names unreadable.
 */

@import "~/.config/ubuntu-setup/palette/rofi.rasi"

configuration {
 font: "Noto Sans 10";
 show-icons: true;
 icon-theme: "Yaru";
 display-drun: "Apps";
 drun-display-format: "{name}";
 disable-history: false;
 fullscreen: false;
 hide-scrollbar: true;
 sidebar-mode: false;
}

* {
 background: #00000000;
 background-alt: #00000000;
 background-bar: @pal-bar;
 foreground: @pal-fg;
 accent: @pal-border;
 text-color: @foreground;
}

window {
 transparency: "real";
 background-color: @pal-bg;
 text-color: @foreground;
 border: 2px;
 border-color: @accent;
 border-radius: 14px;
 width: 46%;
 location: center;
 x-offset: 0;
 y-offset: 0;
}

prompt {
 enabled: true;
 padding: 0.30% 1% 0.30% 0.5%;
 background-color: @background-alt;
 text-color: @foreground;
 font: "Noto Sans 12";
}

entry {
 background-color: @background-alt;
 text-color: @foreground;
 placeholder-color: @foreground;
 expand: true;
 horizontal-align: 0;
 placeholder: "Search";
 padding: 0.10% 0% 0% 0%;
 blink: true;
}

inputbar {
 children: [ prompt, entry ];
 background-color: @background-bar;
 text-color: @foreground;
 expand: false;
 border: 0% 0% 0% 0%;
 border-radius: 12px;
 border-color: @accent;
 margin: 0% 0% 0% 0%;
 padding: 1.5%;
}

listview {
 background-color: @background-alt;
 columns: 5;
 lines: 3;
 spacing: 1.5%;
 cycle: false;
 dynamic: true;
 layout: vertical;
}

mainbox {
 background-color: @background-alt;
 border: 0% 0% 0% 0%;
 border-radius: 0% 0% 0% 0%;
 border-color: @accent;
 children: [ inputbar, listview ];
 spacing: 2%;
 padding: 2% 1% 2% 1%;
}

element {
 background-color: @pal-element;
 text-color: @foreground;
 orientation: vertical;
 border-radius: 10px;
 padding: 2.5% 1% 2.5% 1%;
}

element-icon {
 background-color: transparent;
 size: 54px;
 border: 0px;
}

element-text {
 background-color: transparent;
 expand: true;
 font: "Noto Sans 10";
 text-color: inherit;
 horizontal-align: 0.5;
 vertical-align: 0.5;
 margin: 0.5% 0.5% 0.2% 0.5%;
}

element selected {
 background-color: @pal-selected;
 text-color: @foreground;
 border: 0% 0% 0% 0%;
 border-radius: 12px;
 border-color: @accent;
}
