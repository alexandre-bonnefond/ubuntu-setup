#!/usr/bin/env bash

# Volume of the default output (PipeWire's wpctl, like the volume keys),
# right click mutes, scrolling changes it by 5 % (capped at 100 %). Urgent when not muted.

SINK=@DEFAULT_AUDIO_SINK@

case "$BLOCK_BUTTON" in
  3) wpctl set-mute "$SINK" toggle ;;
  4) wpctl set-mute "$SINK" 0; wpctl set-volume -l 1.0 "$SINK" 5%+ ;;
  5) wpctl set-mute "$SINK" 0; wpctl set-volume "$SINK" 5%- ;;
esac

# "Volume: 0.45" or "Volume: 0.45 [MUTED]"
wpctl get-volume "$SINK" | awk '{ print /MUTED/ ? "MUTE" : sprintf("%d%%", $2 * 100 + 0.5) }' | {
  read -r OUTPUT
  echo "$OUTPUT"
  [ "$OUTPUT" != "MUTE" ] && exit 33
  exit 0
}
