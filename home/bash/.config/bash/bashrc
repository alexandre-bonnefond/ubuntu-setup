# #{ git

# pull and push the current branch (gppl: remote 'local', gppo: 'origin')
gitPullPush() {
  local branch
  branch=$(git branch --show-current)
  git pull "${1:-origin}" "$branch"
  git push "${1:-origin}" "$branch"
}

gitSubmoduleRecursive() {
  git submodule foreach git "$@"
}

# switch the origin remote between git@host:path and https://host/path
git2https() {
  local old new
  old=$(git remote get-url origin)
  echo "Old remote: $old"
  new=$(echo "$old" | sed -r 's|.*git@(.+):(.+)|https://\1/\2|' | head -n 1)
  echo "New remote: $new"
  [ -n "$new" ] && git remote set-url origin "$new"
}

git2ssh() {
  local old new
  old=$(git remote get-url origin)
  echo "Old remote: $old"
  new=$(echo "$old" | sed -r 's|https://([^/]+)/(.+)|git@\1:\2|' | head -n 1)
  echo "New remote: $new"
  [ -n "$new" ] && git remote set-url origin "$new"
}

