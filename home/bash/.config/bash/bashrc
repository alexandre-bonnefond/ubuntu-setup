# #{ processes and retries

# kill a process with all its children
killp() {
  if [ $# -eq 0 ]; then
    echo "killp needs a process id"
    return 1
  fi
  local child
  for child in $(ps -o pid,ppid -ax | awk "{ if ( \$2 == $1 ) { print \$1 }}"); do
    killp "$child"
  done
  kill -9 "$1" >/dev/null 2>&1
}

# rerun a command until it succeeds
auto-retry() {
  false
  while [ $? -ne 0 ]; do
    "$@" || (sleep 1; false)
  done
}

ssh-auto-retry() {
  auto-retry ssh "$@"
}

