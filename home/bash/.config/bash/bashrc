# #{ tmux

forceKillTmuxSession() {
  tmux kill-session -t "$1" 2>/dev/null
}

# :qa kills the tmux session with everything running in it
quitTmuxSession() {
  if [ -n "$TMUX" ]; then
    echo "killing session"
    local pid
    for pid in $(tmux list-panes -s -F "#{pane_pid} #{pane_current_command}" | grep -v tmux | awk '{print $1}'); do
      killp "$pid" &
    done
    tmux kill-session -t "$(tmux display-message -p '#S')"
  else
    exit
  fi
}
alias :qa="quitTmuxSession"

# tmux session named after this shell (T<pid>), attached when it already exists.
# destroy-unattached ends the session when its terminal is gone, even when the terminal
# was killed without running the exit trap below (only for these sessions, scripts
# that start a detached session and attach later keep working).
# When the session ends, cd to the folder it was killed from (prefix + k, :qa).
runTmux() {
  local session="T$BASHPID"
  if tmux has-session -t "=$session" 2>/dev/null; then
    tmux -2 attach-session -t "$session"
  else
    tmux new-session -s "$session" \; set-option destroy-unattached on
  fi
  if [ -f /tmp/tmux_restore_path.txt ]; then
    cd "$(tail -n 1 /tmp/tmux_restore_path.txt)"
    rm /tmp/tmux_restore_path.txt
  fi
}

# #}

# cmdvault: save, rec, cv, Ctrl+G search, Ctrl+X s save (~/git/cmdvault)
[ -f ~/git/cmdvault/shell/cmdvault.bash ] && source ~/git/cmdvault/shell/cmdvault.bash

# #{ interactive: tmux in every kitty terminal

case $- in
  *i*)
    # closing the terminal ends its tmux session
    _trap_exit() {
      pwd >> /tmp/tmux_restore_path.txt
      forceKillTmuxSession "T$BASHPID"
    }
    trap _trap_exit EXIT

    # only in kitty, not in the shells of IDEs and apps (Cursor, Claude Desktop, ...)
    if [ "${RUN_TMUX:-true}" = true ] && [ -z "$TMUX" ] && [ "$TERM" = xterm-kitty ] && command -v tmux >/dev/null; then
      runTmux
    fi
    ;;
esac

