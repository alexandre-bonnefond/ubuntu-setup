# #{ tools

# ranger, then cd to where it was left
ranger() {
  command ranger --choosedir=/tmp/lastrangerdir "$@"
  cd "$(cat /tmp/lastrangerdir)"
}

# ranger in the mounted drives (used by the tmux mount menu, prefix + m)
cd_media() {
  cd "/media/$USER" && ranger
}

# papis without arguments is 'papis edit'
papis() {
  [ $# -eq 0 ] && set -- edit
  command papis "$@"
}

# first frame (or the frame at $2, e.g. 00:00:05) of a video as <name>_thumbnail.jpg
getVideoThumbnail() {
  if [ $# -eq 0 ]; then
    echo "usage: getVideoThumbnail VIDEO [TIME]"
    return 1
  fi
  ffmpeg -i "$1" -ss "${2:-00:00:01}" -vframes 1 "${1%.*}_thumbnail.jpg"
}

